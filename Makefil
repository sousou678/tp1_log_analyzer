# Variables
LOG_FILE = samples/auth_sample.log

# Commande par défaut : analyse du log
run:
	cargo run -- $(LOG_FILE)

# Lancer tous les tests
test:
	cargo test

# Vérifier la qualité du code (Formatage + Clippy)
lint:
	cargo fmt --check
	cargo clippy -- -D warnings

# Tout faire d'un coup (Vérification complète avant soumission)
all: lint test run
